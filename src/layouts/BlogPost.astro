---
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

type Props = Partial<CollectionEntry<"blog">["data"]> & {
  frontmatter?: Partial<CollectionEntry<"blog">["data"]>;
  headings?: MarkdownHeading[];
};

// markdown pages pass their frontmatter as Astro.props.frontmatter
const { title, description, pubDate, updatedDate, heroImage } =
  Astro.props.frontmatter ?? Astro.props;
const toc = (Astro.props.headings ?? []).filter(
  ({ depth }) => depth === 2 || depth === 3,
);
---

<html lang="ja">
  <Head title={title} description={description} />
  <body>
    <Header />
    <main class="shell">
      <article>
        {heroImage && <img width={720} height={360} src={heroImage} alt="" />}
        <header class="page-top">
          <h1>{title}</h1>
          <div class="article-meta">
            {pubDate && (
              <span>
                Published <FormattedDate date={pubDate} />
              </span>
            )}
            {updatedDate && (
              <span>
                Last updated on <FormattedDate date={updatedDate} />
              </span>
            )}
          </div>
        </header>
        <div class:list={["article-layout", { "no-aside": toc.length === 0 }]}>
          {toc.length > 0 && (
            <nav class="article-aside" aria-label="On this page">
              <h2>On this page</h2>
              <ul>
                {toc.map(({ depth, slug, text }) => (
                  <li class={`depth-${depth}`}>
                    <a href={`#${slug}`}>{text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
          <div class="prose">
            <slot />
          </div>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
