---
import face from "../assets/anime_face.png";
import BioSummary from "../components/BioSummary.astro";
import { BIO_SUMMARY_SETTINGS } from "../consts";
import Layout from "../layouts/BlogPost.astro";
---

<Layout
  title="TakashiAihara's Bio"
  description="TakashiAihara's Bio"
  pubDate={new Date("July 25 2023")}
  updatedDate={new Date("July 25 2023")}
>
  <h2>This page is work in progress. I'm sorry.</h2>
  <img
    class="avatar"
    src={face.src}
    width="200"
    alt="My face, generated by stable-diffusion"
    style="margin-bottom: var(--s-5)"
  />
  <BioSummary summaries={BIO_SUMMARY_SETTINGS} />
</Layout>
