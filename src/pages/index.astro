---
import { Image } from "astro:assets";
import face from "../assets/anime_face.png";
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  IT_CARRIER_SUMMARY_SETTINGS,
  DANCER_CARRIER_SUMMARY_SETTINGS,
  BIO_SUMMARY_SETTINGS,
} from "../consts";
import NestedSummary from "../components/NestedSummary.astro";
import BioSummary from "../components/BioSummary.astro";
import ClosingWords from "../components/ClosingWords.astro";
---

<!doctype html>
<html lang="ja">
  <Head title={SITE_TITLE} description={SITE_DESCRIPTION} />
  <body>
    <Header />
    <main class="shell home-grid">
      <section class="hero">
        <div>
          <p class="eyebrow">Full-stack engineer</p>
          <h1>Hi, I am Takashi Aihara</h1>
          <BioSummary summaries={BIO_SUMMARY_SETTINGS} />
        </div>
        <div class="avatar-wrap">
          <Image
            class="avatar"
            src={face}
            width={240}
            height={240}
            fit="cover"
            alt="My face, generated by stable-diffusion"
          />
          <span class="caption">Converted by stable-diffusion</span>
        </div>
      </section>
      <section class="panel">
        <h2>IT Career Summary</h2>
        <NestedSummary summaries={IT_CARRIER_SUMMARY_SETTINGS} />
        <p class="career-note">
          Bar length is relative to the longest listed role.
        </p>
      </section>
      <section class="panel">
        <h2>Amateur Dancer Career Summary</h2>
        <NestedSummary summaries={DANCER_CARRIER_SUMMARY_SETTINGS} />
      </section>
      <ClosingWords />
    </main>
    <Footer />
  </body>
</html>
