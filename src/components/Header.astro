---
import { HEADER_SNS_SETTINGS, HEADER_CONTENT_SETTINGS } from "../consts";
import HeaderNavLink from "./HeaderNavLink.astro";
import HeaderSnsLink from "./HeaderSnsLink.astro";
---

<header class="masthead">
  <div class="shell head-inner">
    <a class="brand" href="/">
      Takashi Aihara
    </a>
    <nav class="nav" aria-label="Primary">
      {HEADER_CONTENT_SETTINGS.map(({ name, icon, activeIcon, alt }) => (
        <HeaderNavLink {name} {alt} href={`/${name}`} {icon} {activeIcon} />
      ))}
    </nav>
    <div class="social">
      {HEADER_SNS_SETTINGS.map(({ url, name, icon }) => (
        <HeaderSnsLink {name} href={url} {icon} />
      ))}
    </div>
  </div>
</header>
