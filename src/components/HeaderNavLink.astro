---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import { convertInitialUpperCase } from "../utils/convert";

type Props = HTMLAttributes<"a"> & {
  icon: string;
  activeIcon?: string;
  name: string;
  alt?: string;
};

const { icon, activeIcon, name, alt, href, ...props } = Astro.props;

const { pathname } = Astro.url;
// A section link (not Home) stays current on the pages under it, e.g. /blog on /blog/<post>/.
const isPage = href === pathname || href === pathname.replace(/\/$/, "");
const isActive = isPage || (!!name && pathname.startsWith(`${href}/`));
---

<a
  {href}
  aria-current={isPage ? "page" : isActive ? "location" : undefined}
  {...props}
>
  <Icon name={isActive && activeIcon ? activeIcon : icon} aria-hidden="true" />
  <span>{name ? convertInitialUpperCase(name) : alt}</span>
</a>
