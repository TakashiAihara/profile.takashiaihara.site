---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";
import { convertInitialUpperCase } from "../utils/convert";

type Props = HTMLAttributes<"a"> & {
  icon: string;
  activeIcon?: string;
  name: string;
  alt?: string;
};

const { icon, activeIcon, name, alt, href, ...props } = Astro.props;

const { pathname } = Astro.url;
const isActive = href === pathname || href === pathname.replace(/\/$/, "");
---

<a {href} aria-current={isActive ? "page" : undefined} {...props}>
  <Icon name={isActive && activeIcon ? activeIcon : icon} aria-hidden="true" />
  <span>{name ? convertInitialUpperCase(name) : alt}</span>
</a>
