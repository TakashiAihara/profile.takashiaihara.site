---
import type { HTMLAttributes } from "astro/types";
import { Icon } from "astro-icon/components";

type Props = HTMLAttributes<"a"> & {
  icon: string;
  name: string;
};

const { icon, name, href, ...props } = Astro.props;
---

<a
  {href}
  target="_blank"
  rel="noopener"
  aria-label={name}
  title={name}
  {...props}
>
  <Icon name={icon} aria-hidden="true" />
</a>
