---
interface Summary {
  summary: string;
  year: number;
}

interface Props {
  summaries: Summary[];
  // Pass a shared maximum when several lists sit side by side, so equal years draw equal bars.
  max?: number;
}

const { summaries } = Astro.props;
const max = Astro.props.max ?? Math.max(...summaries.map(({ year }) => year));
---

<ul class="career-list">
  {summaries.map(({ summary, year }) => (
    <li class="career-item">
      <strong>{summary}</strong>
      <span class="years">
        {year} {year === 1 ? "year" : "years"}
      </span>
      <span class="meter" aria-hidden="true">
        <span style={`--bar: ${(year / max) * 100}%`} />
      </span>
    </li>
  ))}
</ul>
