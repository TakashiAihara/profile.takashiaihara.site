---
interface Props {
  // markdown page frontmatter is not schema-validated, so dates arrive as strings
  date: Date | string;
}

const date = new Date(Astro.props.date);
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString("ja-jp", {
      year: "numeric",
      month: "short",
      day: "numeric",
      timeZone: "Asia/Tokyo",
    })
  }
</time>
